#!/bin/bash

# 安装后回调
# 配置文件由程序首次启动时自动生成（config.SaveDefault），无需在此手动创建。
# 所有配置项均通过飞牛桌面应用图标进入 Web 配置页面完成。

LOG_FILE="${TRIM_PKGVAR}/upgrade.log"
echo "$(date '+%Y-%m-%d %H:%M:%S') [install_callback] 开始执行 install_callback 脚本" >> "${LOG_FILE}" 2>/dev/null || true

# 检查二进制文件信息
if [ -f "${TRIM_APPDEST}/fnmusic-sync" ]; then
    BIN_SIZE=$(stat -c%s "${TRIM_APPDEST}/fnmusic-sync" 2>/dev/null || stat -f%z "${TRIM_APPDEST}/fnmusic-sync" 2>/dev/null || echo "unknown")
    echo "$(date '+%Y-%m-%d %H:%M:%S') [install_callback] 安装后二进制大小=${BIN_SIZE}" >> "${LOG_FILE}" 2>/dev/null || true
else
    echo "$(date '+%Y-%m-%d %H:%M:%S') [install_callback] ⚠️ 二进制文件不存在: ${TRIM_APPDEST}/fnmusic-sync" >> "${LOG_FILE}" 2>/dev/null || true
fi

# 安装向导开关：debug 模式（field=wizard_debug）。
# 向导字段会以同名环境变量 wizard_debug 传入；二进制运行时直接读取该环境变量决定是否开启
# 请求/响应明细日志（capture 日志），默认关闭。这里仅登记其值，无需写任何配置文件。
WIZARD_DEBUG="${wizard_debug:-}"
if [ -n "${WIZARD_DEBUG}" ]; then
    echo "$(date '+%Y-%m-%d %H:%M:%S') [install_callback] 收到向导 debug 变量 wizard_debug=${WIZARD_DEBUG}（程序运行时读取该环境变量生效）" >> "${LOG_FILE}" 2>/dev/null || true
else
    echo "$(date '+%Y-%m-%d %H:%M:%S') [install_callback] 未收到向导 debug 变量（默认关闭）" >> "${LOG_FILE}" 2>/dev/null || true
fi

echo "$(date '+%Y-%m-%d %H:%M:%S') [install_callback] install_callback 执行完成" >> "${LOG_FILE}" 2>/dev/null || true

exit 0
