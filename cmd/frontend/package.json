{
  "description": "飞牛音乐 Scrobble 代理 Web UI 前端",
  "devDependencies": {
    "@codecov/vite-plugin": "^2.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@trimjs/web-app": "^0.6.0",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "clsx": "^2.1.1",
    "knip": "^6.45.1",
    "oxlint": "^1.93.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-i18n": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "name": "fnmusic-sync-frontend",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "vite build",
    "deps:clean": "knip --fix",
    "dev": "vite",
    "format": "prettier --write --tab-width 2 --semi true --single-quote true --trailing-comma all --print-width 120 --html-whitespace-sensitivity css --plugin=prettier-plugin-svelte \"../../internal/webui/www/**/*.{html,css,js}\" \"!../../internal/webui/www/app.css\" \"!../../internal/webui/www/app.js\" \"src/**/*.{html,css,js,ts,svelte}\"",
    "lint": "pnpm run lint:types && pnpm run lint:eslint",
    "lint:eslint": "oxlint",
    "lint:types": "tsc --noEmit",
    "lint:unused": "knip"
  },
  "type": "module",
  "version": "1.0.0"
}
