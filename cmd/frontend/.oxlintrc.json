{
  "env": {
    "browser": true
  },
  "ignorePatterns": [
    "dist",
    "build",
    "node_modules",
    ".svelte-check"
  ],
  "rules": {
    "no-console": "off",
    "no-explicit-any": "warn",
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ]
  }
}
